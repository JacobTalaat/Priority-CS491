generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  canvasTokenCipher String?
  canvasTokenIv     String?
  canvasTokenTag    String?
  canvasBaseUrl     String?
  canvasCheckedAt   DateTime?
  canvasCalendarFeedCipher String?
  canvasCalendarFeedIv     String?
  canvasCalendarFeedTag    String?
  lastSyncedAt      DateTime?
  sessions          Session[]
  courses           Course[]
  itemStates        ItemState[]
  itemEvents        ItemEvent[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String    @id @default(cuid())
  userId       String
  canvasId     String
  name         String
  courseCode   String?
  term         String?
  termEndsAt   DateTime?
  isCurrent    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentGroups AssignmentGroup[]
  assignments      Assignment[]
  gradeSetup       CourseGradeSetup?
  syllabus         CourseSyllabus?

  @@unique([userId, canvasId])
}

model CourseGradeSetup {
  id                 String   @id @default(cuid())
  courseId           String   @unique
  categories         Json
  assignmentMappings Json
  finalExamWeight    Float
  cutoffs            Json
  classDetails       Json
  confirmedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseSyllabus {
  id          String   @id @default(cuid())
  courseId    String   @unique
  fileName    String
  sizeBytes   Int
  pageCount   Int
  text        String
  extractedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model AssignmentGroup {
  id          String   @id @default(cuid())
  courseId    String
  canvasId    String
  name        String
  groupWeight Float?
  position    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([courseId, canvasId])
}

model Assignment {
  id                String   @id @default(cuid())
  courseId          String
  assignmentGroupId String?
  canvasId          String
  title             String
  dueAt             DateTime?
  hasDueDate        Boolean
  pointsPossible    Float
  htmlUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentGroup AssignmentGroup? @relation(fields: [assignmentGroupId], references: [id], onDelete: SetNull)
  grade           Grade?
  states          ItemState[]
  events          ItemEvent[]

  @@unique([courseId, canvasId])
  @@index([courseId, dueAt])
}

model Grade {
  id           String    @id @default(cuid())
  assignmentId String    @unique
  score        Float?
  gradedAt     DateTime?
  submittedAt  DateTime?
  excused      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model AiSpendMonth {
  period         String    @id
  spentMicros    BigInt    @default(0)
  reservedMicros BigInt    @default(0)
  updatedAt      DateTime  @updatedAt
  warnedAt       DateTime?
}

model AiUsageDay {
  // Postgres treats NULLs as distinct in unique constraints, so a missing userId
  // is stored as "" to keep the usage upsert reading and writing exactly one row.
  day          String
  feature      String
  userId       String
  // counts up. calls counts every provider call; failedCalls the failed subset.
  calls        BigInt   @default(0)
  failedCalls  BigInt   @default(0)
  inputTokens  BigInt   @default(0)
  outputTokens BigInt   @default(0)
  costMicros   BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@id([day, feature, userId])
}

// Per-student state of a to-do item: done until undone, or skipped for one
// New York day. Keyed by the student so two students on the same assignment
// never share state.
model ItemState {
  userId       String
  assignmentId String
  // "done" or "skipped"; done needs no day, so skippedDay only fills for skips.
  status       String
  // The YYYY-MM-DD America/New_York day the skip applies to; a skip from
  // yesterday stops hiding the item at midnight ET.
  skippedDay   String?
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@id([userId, assignmentId])
}

// Append-only record of the student's taps (done, skip, undo) with the client
// they came from: the audit trail the ranking study later reads. Kept alive
// after Canvas deletes an assignment, so the study can still tell what that
// item was (courseId and assignmentCanvasId ride along un-normalised).
model ItemEvent {
  id           String   @id @default(cuid())
  userId       String
  // Null once the assignment row is synced away; the item stays identifiable
  // through courseId and assignmentCanvasId below.
  assignmentId String?
  // Written at tap time, never nulled when the assignment goes.
  courseId            String
  assignmentCanvasId  String
  // "done", "skip" or "undo".
  action       String
  // "web", "app" or "unknown" (no header, or a value neither client sends).
  client       String
  // What the client says it displayed when it tapped, so the study can tell
  // whether the tested behaviour was at the top of the list.
  shownRank         Int?
  listGeneratedAt   DateTime?
  serverRank        Int?
  // The exact response body the request returned, so a retried tap with the
  // same requestId replays it without touching state or history again.
  response          Json?
  // Client-supplied idempotency key (X-Priority-Request-Id): retried taps do
  // not double-log. Unique per user; Postgres allows many NULL requestIds.
  requestId    String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}
