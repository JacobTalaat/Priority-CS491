# The connection the running app uses. On Supabase this is the transaction
# pooler on port 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional. The connection migrations use. It must hold a session open, because
# the transaction pooler cannot keep the advisory locks Prisma takes.
#
# On Supabase use the SESSION pooler, port 5432 on the same pooler host. Do not
# use the "Direct connection" host (db.PROJECT_REF.supabase.co) unless you know
# you have IPv6: it publishes no IPv4 address, so on an IPv4-only network it
# fails to connect at all.
#
# Leave this unset when DATABASE_URL is already a direct connection, such as a
# local PostgreSQL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth. Accounts live in a Supabase Auth project; find both values in
# Project Settings -> Data API / API Keys. The URL and publishable key are safe
# for the browser; Next.js only inlines NEXT_PUBLIC_ variables into client code.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server only, never NEXT_PUBLIC_: used by the API to delete a Supabase auth
# user when an account is deleted. Treat it like a database password.
SUPABASE_SECRET_KEY=""

# Three dashboard settings are required before real accounts exist (Authentication
# section). With "Confirm email" off, anyone can sign up with somebody else's
# address and receive a session without proving they can read that mailbox, so
# enable it on the email provider. And keep asymmetric JWT signing keys, so the
# server verifies tokens locally instead of making a call per request.
#
# Email links land on pages of this app, and Supabase only completes them when
# those URLs are on the allow list: under Authentication -> URL Configuration,
# set the Site URL to the app origin and add both <app origin>/auth/confirm
# (sign-up confirmation) and <app origin>/reset-password (forgot password) to
# Redirect URLs; while developing, the http://localhost:3000 versions. Without
# them Supabase refuses to send those emails.

# Generate with: openssl rand -base64 32
CANVAS_TOKEN_ENCRYPTION_KEY=""

# Optional, defaults to https://canvas.instructure.com
CANVAS_BASE_URL=""

# AI provider base URL for an OpenAI-compatible chat completions endpoint.
AI_BASE_URL="https://openrouter.ai/api/v1"

# Model id and API key. The key is used server-side only, never in the browser.
AI_MODEL=""
AI_API_KEY=""

# Prices in USD per million tokens. Use 0 for a free model.
AI_INPUT_USD_PER_MILLION_TOKENS="0"
AI_OUTPUT_USD_PER_MILLION_TOKENS="0"

# Hard monthly spending cap in USD, shared across every user of the app.
AI_MONTHLY_BUDGET_USD="2.99"

# Optional, defaults to 60000.
AI_TIMEOUT_MS=""

# Web push (VAPID) credentials so the website can deliver browser notifications.
# Generate the pair once with: npx web-push generate-vapid-keys
# The pair is validated together at startup; they must belong to each other.
VAPID_PUBLIC_KEY=""
# Server-side only; the private half never reaches the browser.
VAPID_PRIVATE_KEY=""
# The subject is a contact address, either mailto:you@example.com or an https: URL.
VAPID_SUBJECT=""
