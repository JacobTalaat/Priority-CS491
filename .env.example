# The connection the running app uses. On Supabase this is the transaction
# pooler on port 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional. The connection migrations use. It must hold a session open, because
# the transaction pooler cannot keep the advisory locks Prisma takes.
#
# On Supabase use the SESSION pooler, port 5432 on the same pooler host. Do not
# use the "Direct connection" host (db.PROJECT_REF.supabase.co) unless you know
# you have IPv6: it publishes no IPv4 address, so on an IPv4-only network it
# fails to connect at all.
#
# Leave this unset when DATABASE_URL is already a direct connection, such as a
# local PostgreSQL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
CANVAS_TOKEN_ENCRYPTION_KEY=""

# Optional, defaults to https://canvas.instructure.com
CANVAS_BASE_URL=""

# AI provider base URL for an OpenAI-compatible chat completions endpoint.
AI_BASE_URL="https://openrouter.ai/api/v1"

# Model id and API key. The key is used server-side only, never in the browser.
AI_MODEL=""
AI_API_KEY=""

# Prices in USD per million tokens. Use 0 for a free model.
AI_INPUT_USD_PER_MILLION_TOKENS="0"
AI_OUTPUT_USD_PER_MILLION_TOKENS="0"

# Hard monthly spending cap in USD, shared across every user of the app.
AI_MONTHLY_BUDGET_USD="2.99"

# Optional, defaults to 60000.
AI_TIMEOUT_MS=""
