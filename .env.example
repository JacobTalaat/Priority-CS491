# The connection the running app uses. On Supabase this is the pooler on port
# 6543, which is what a serverless deployment needs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Optional. The connection migrations use, which must be a direct one because
# the pooler cannot hold the advisory locks Prisma takes. On Supabase this is
# port 5432. Leave it unset when DATABASE_URL is already a direct connection,
# such as a local PostgreSQL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Generate with: openssl rand -base64 32
CANVAS_TOKEN_ENCRYPTION_KEY=""

# Optional, defaults to https://canvas.instructure.com
CANVAS_BASE_URL=""
